<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Add Custom Rule"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"
            android:layout_marginBottom="16dp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRuleName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Rule Name"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="#3B82F6"
            app:hintTextColor="#94A3B8"
            android:layout_marginBottom="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRuleName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textColor="#F8FAFC" />

        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilRulePattern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Prefix or Number Pattern (e.g. +34, +441234)"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            app:boxStrokeColor="#3B82F6"
            app:hintTextColor="#94A3B8"
            app:helperText="Start with '+' and country code (e.g. +34 or +441234)"
            app:helperTextTextColor="#94A3B8"
            android:layout_marginBottom="14dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/etRulePattern"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="phone"
                android:textColor="#F8FAFC" />

        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Match Rule Type"
            android:textSize="13sp"
            android:textColor="#94A3B8"
            android:textStyle="bold"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgMatchType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rbTypePrefix"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Prefix (Starts With, e.g. +91140909)"
                android:textColor="#F8FAFC"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbTypeExact"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Exact Number (Full 10-12 digits)"
                android:textColor="#F8FAFC" />

            <RadioButton
                android:id="@+id/rbTypeWildcard"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Wildcard Pattern (e.g. +91140*)"
                android:textColor="#F8FAFC" />

        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Action When Call Detected"
            android:textSize="13sp"
            android:textColor="#94A3B8"
            android:textStyle="bold"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="4dp" />

        <RadioGroup
            android:id="@+id/rgAction"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="12dp">

            <RadioButton
                android:id="@+id/rbBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Block &amp; Disconnect immediately"
                android:textColor="#F8FAFC"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbSilence"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Silence Ringer (Do not ring, allow voicemail)"
                android:textColor="#F8FAFC" />

        </RadioGroup>

        <CheckBox
            android:id="@+id/cbSkipNotification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hide notification when blocked"
            android:textColor="#CBD5E1"
            android:checked="true" />

        <CheckBox
            android:id="@+id/cbSkipCallLog"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Do not add to Android phone dialer history"
            android:textColor="#CBD5E1"
            android:checked="true" />

    </LinearLayout>

</ScrollView>
