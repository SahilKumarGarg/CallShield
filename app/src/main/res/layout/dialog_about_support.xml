<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#1E293B">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- Header Info -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <androidx.appcompat.widget.AppCompatImageView
                android:id="@+id/ivAboutLogo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_callshield_logo"
                app:srcCompat="@drawable/ic_callshield_logo"
                android:contentDescription="Call Shield Logo" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvAboutAppName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Call Shield"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC" />

                <TextView
                    android:id="@+id/tvAboutAppVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v2.4 • 100% Offline Spam Screener"
                    android:textSize="12sp"
                    android:textColor="#94A3B8" />

            </LinearLayout>

        </LinearLayout>

        <!-- Privacy & Security Guarantee -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="12dp"
            app:cardBackgroundColor="#0F172A"
            app:strokeWidth="1dp"
            app:strokeColor="#334155"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔒 100% Offline &amp; Zero Telemetry"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="#34D399" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Zero internet permissions declared in manifest. Zero ads, zero trackers, and zero external servers. All rules and call logs are processed and stored strictly on your local device."
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginTop="4dp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Creator Profile Section -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Built with ❤️ &amp; security in mind by Sahil Kumar"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#E2E8F0" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Free &amp; Open Source Project"
            android:textSize="12sp"
            android:textColor="#64748B"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="16dp" />

        <!-- ACTION BUTTON 1: Buy Me a Coffee (PayPal / Card) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAboutBuyCoffee"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="☕ Buy Me a Coffee (PayPal)"
            android:textColor="#0F172A"
            android:textStyle="bold"
            android:textSize="14sp"
            app:backgroundTint="#F59E0B"
            app:cornerRadius="12dp"
            android:paddingVertical="12dp"
            android:layout_marginBottom="10dp" />

        <!-- ACTION BUTTON 2: UPI Scanner / ID (India) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAboutUpiScan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🇮🇳 Support via UPI (GPay / PhonePe / QR)"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:backgroundTint="#059669"
            app:cornerRadius="12dp"
            android:paddingVertical="12dp"
            android:layout_marginBottom="10dp" />

        <!-- ACTION BUTTON 3: LinkedIn Profile -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAboutLinkedin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💼 Connect on LinkedIn"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="13sp"
            app:backgroundTint="#0A66C2"
            app:cornerRadius="12dp"
            android:paddingVertical="12dp"
            android:layout_marginBottom="10dp" />

        <!-- ACTION BUTTON 4: GitHub Repository -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAboutGithub"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⭐ Star on GitHub (Open Source)"
            android:textColor="#F1F5F9"
            android:textStyle="bold"
            android:textSize="13sp"
            app:backgroundTint="#334155"
            app:strokeColor="#475569"
            app:strokeWidth="1dp"
            app:cornerRadius="12dp"
            android:paddingVertical="12dp"
            android:layout_marginBottom="6dp" />

        <TextView
            android:id="@+id/tvUpiHint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="UPI ID: sahilgarg50@oksbi (Tap UPI button to copy or open)"
            android:textSize="11sp"
            android:textColor="#64748B"
            android:gravity="center"
            android:layout_marginTop="8dp" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
